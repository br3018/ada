// This dev container sets up the development environment for Ada.
// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "ADA",
	"build": {
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "latest"
		},
		// Docker in Docker for running the SysML v2 API server (see sysml-api/).
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
	},
	// Set up virtual environment in container
	"postCreateCommand": "uv sync",

	// Forward the SysML v2 API server to the host (Swagger UI at /docs/).
	"forwardPorts": [9000],
	"portsAttributes": {
		"9000": {
			"label": "SysML v2 API",
			"onAutoForward": "notify"
		}
	},

	"remoteUser": "vscode",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
			},
			"extensions": [
				// SysML v2 language support
				"sensmetry.syside-editor",
				// Claude VS code extension
				"anthropic.claude-code",
				// GitHub extensions
				"github.vscode-pull-request-github",
				// Python verification tools
				"ms-python.python",
				"ms-python.vscode-pylance",
				// Markdown linting
				"davidanson.vscode-markdownlint"
			]
		}
	}
}
