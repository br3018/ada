// This dev container sets up the development environment for Ada.
// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "Ada",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "latest"
		}
	},
	// Create the virtual environment in the container.
	"postCreateCommand": "uv sync",

	"remoteUser": "vscode",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venvs/ada/bin/python"
			},
			"extensions": [
				// SysML v2 language support
				"sensmetry.syside-editor",
				// Claude VS code extension
				"anthropic.claude-code",
				// GitHub extensions
				"github.vscode-pull-request-github",
				// Python tools for verification
				"ms-python.python",
				"ms-python.vscode-pylance",
				// Markdown linting
				"davidanson.vscode-markdownlint",
				// Makefile support
				"ms-vscode.makefile-tools"
			]
		}
	},
	// Persist Claude authentication
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		// Keep the venv on the container filesystem, with the uv cache and Python. The workspace can be
		// a slow Windows mount. A venv there also stays after the container removes its Python.
		"UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/ada"
	}
}
