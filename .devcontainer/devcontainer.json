// This dev container sets up the development environment for Ada.
// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "Ada",
	"build": {
		"dockerfile": "Dockerfile",
		// The repository root, so the build can read the pilot release from sysml-versions.env
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "latest"
		},
		// Docker in Docker for running the SysML v2 API server (see sysml-api/).
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
	},
	// Set up virtual environment in container
	"postCreateCommand": "uv sync",

	// Forward the SysML v2 API server to the host (Swagger UI at /docs/).
	"forwardPorts": [9000],
	"portsAttributes": {
		"9000": {
			"label": "SysML v2 API",
			"onAutoForward": "notify"
		}
	},

	"remoteUser": "vscode",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venvs/ada/bin/python"
			},
			"extensions": [
				// SysML v2 language support
				"sensmetry.syside-editor",
				// Claude VS code extension
				"anthropic.claude-code",
				// GitHub extensions
				"github.vscode-pull-request-github",
				// Python verification tools
				"ms-python.python",
				"ms-python.vscode-pylance",
				// Notebooks, including the SysML kernel
				"ms-toolsai.jupyter",
				// Markdown linting
				"davidanson.vscode-markdownlint"
			]
		}
	},
	// Persist Claude authentication
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		// Keep the venv on the container filesystem, next to uv's cache and Python. The workspace can be
		// a slow Windows mount, and a venv there outlives the uv-managed Python it links to.
		"UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/ada"
	}
}
