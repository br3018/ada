# SysML v2 Pilot Implementation release used by Ada. Both Docker images read this file:
# - sysml-api/Dockerfile builds the API server from SYSML_RELEASE (a SysML-v2-API-Services tag)
# - .devcontainer/Dockerfile installs the matching Jupyter kernel from its conda-forge package
# They must come from the same release. After changing it, rebuild the dev container and run make api-up.
SYSML_RELEASE=2026-04
SYSML_KERNEL_VERSION=0.59.0
SYSML_KERNEL_SHA256=b7269d3e3e1a3b89dae0b6e8185d3c0face99504b7f0ec86be75ffe002f82779
